# ai-bot-platform — example environment.
# Copy to `.env` for local dev. Never commit `.env`.
#
# `manage.py`, `config/wsgi.py`, `config/asgi.py`, and `config/celery.py`
# auto-load `.env` from the project root (via `python-dotenv`) before
# Django reads settings. Real shell env vars take precedence over `.env`
# entries (`override=False`), so a one-off shell export still wins.
# Production deploys typically supply env via the platform's secret
# store and have no `.env` file — the autoloader is a no-op there.

# Django
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=replace-me-in-staging-and-prod
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Postgres (Sprint 0 / A2 — DRF-404 docker compose)
DATABASE_URL=postgres://platform:platform@localhost:5432/ai_bot_platform

# Redis (Sprint 1)
REDIS_URL=redis://localhost:6379/0

# Celery (Sprint 1)
CELERY_BROKER_URL=redis://localhost:6379/1

# chromadb (Sprint 7 — KB migration)
CHROMA_HTTP_HOST=localhost
CHROMA_HTTP_PORT=8001
# Sprint 7 / M4 (DRF-595) — Bearer-token auth for ChromaDB. Empty
# value = anonymous (OK for local dev where chromadb is on an
# isolated docker network). Staging / production MUST set this to a
# 32+ char random string matching the value passed to the `chromadb`
# service as CHROMA_SERVER_AUTHN_CREDENTIALS. Required in production
# (settings/production.py fail-fast). See infra/README.md →
# "ChromaDB Bearer auth" for the rotation runbook.
CHROMA_AUTH_TOKEN=

# MinIO / S3 (Sprint 5 replay)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REPLAY_BUCKET=ai-bot-replay

# OpenAI (Sprint 1+)
OPENAI_API_KEY=
OPENAI_PROXY=

# Field-level encryption (ADR-0006, Sprint 2)
DJANGO_CRYPTOGRAPHY_KEY=

# Tenancy (Sprint 2)
DEFAULT_TENANT_SLUG=formula-tela
STRICT_TENANT_SCOPE=audit

# Catalog sync — mysite → platform mirror (Sprint 7 / C8 / DRF-578)
# Service-token (must match the token configured on mysite via M2 / DRF-593).
# Required in production (settings/production.py fail-fast).
MYSITE_CATALOG_BASE_URL=https://formulatela58.ru
MYSITE_CATALOG_SERVICE_TOKEN=
CATALOG_SYNC_LOCK_TTL_SECONDS=1500
CATALOG_SYNC_HTTP_TIMEOUT=30
CATALOG_SYNC_HTTP_RETRIES=3

# apps/eventbus/ — domain bus subscriber registry (Phase 2.2).
#
# Comma-separated dotted paths to apps.eventbus.dispatcher.Subscriber
# implementations. The dispatcher (Celery beat) hands every dispatched
# DomainEvent envelope to each subscriber in turn.
#
# Phase 2.2 ships one real subscriber (AuditSubscriber) mirroring every
# event into apps.audit.AuditLog. Production default below activates it;
# dev/staging may leave it Noop to avoid AuditLog noise.
#
# Order matters: subscribers run sequentially per event, one failing
# subscriber marks the row "failed" but does not block the others on
# the same envelope (per dispatcher contract). For high-throughput
# real subscribers (loyalty/billing later), put them BEFORE
# AuditSubscriber so audit captures the post-processing outcome.
#
#   Default (Phase 2.1 behavior, no audit):
#     apps.eventbus.dispatcher.NoopSubscriber
#
#   Production (Phase 2.2 audit activation):
#     apps.eventbus.subscribers.AuditSubscriber
DOMAIN_EVENT_SUBSCRIBERS=apps.eventbus.dispatcher.NoopSubscriber

# Google Docs read-only client (KB-RAG Sub-4b / GH #128).
# The client takes NO credentials — source docs are fetched via the
# public Markdown export endpoint and each doc must be link-shareable
# ("Anyone with the link can view"). See
# docs/operations/google-docs-public-link.md for the one-time per-doc
# setup. No env var is needed here.
