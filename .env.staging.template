# .env.staging TEMPLATE — copy to .env.staging and fill values OUT OF GIT.
# Names only here (secrets never committed). Loaded by every service via
# env_file in docker-compose.staging.yml. Values for the orchestrator.

# --- Django core ---
DJANGO_SECRET_KEY=            # REQUIRED — Django signing key (long random).
DJANGO_ALLOWED_HOSTS=         # REQUIRED — e.g. 194.87.99.126,localhost,127.0.0.1

# --- Ayla internal API (booking/catalog/personal-context/billing) ---
AYLA_BASE_URL=                # REQUIRED — Ayla on this host: http://127.0.0.1:8000
AYLA_INTERNAL_API_TOKEN=      # REQUIRED — shared s2s Bearer with Ayla.
AYLA_CLIENT_PAYMENTS_RETURN_URL=  # C7 fallback return_url (miniapp public URL) until W4 FE sends it explicitly.

# --- Eventbus ingest (Ayla outbox → bot) ---
EVENT_INGEST_HMAC_SECRET=     # REQUIRED — == Ayla's AYLA_OUTBOUND_HMAC_SECRET.
# T-02 pilot ingest scope. BOTH are REQUIRED for any tenant-scoped event to be
# ingested — empty means DENY ALL, and staging no longer has a global fail-open
# to fall back on. Leaving these blank is SAFE but silently dead: every
# booking.* delivery from Ayla will 500 and dead-letter.
# No wildcards; a malformed value refuses to boot. Rollback = clear both.
# See docs/runbooks/eventbus-subscriber-activation.md §E.
EVENT_INGEST_ALLOWED_TENANTS= # REQUIRED for pilot ingest — CSV of tenant UUIDs.
EVENT_INGEST_ALLOWED_EVENTS=  # REQUIRED for pilot ingest — CSV of event names, e.g.
                              # booking.created,booking.cancelled,appointment.rescheduled
# EVENT_INGEST_TENANT_VERIFY_FAIL_OPEN=  # DO NOT SET. Emergency escape hatch that
                              # disables tenant verification for EVERY tenant and EVERY
                              # event. Widen the two allowlists above instead. See §E.

# --- Public addresses (DRF-1079) ---
# REQUIRED on any contour that is not the developer's laptop. Master invite
# DMs embed <SITE_DOMAIN>/onboarding/master?token=... as the web fallback;
# unset means the repository default http://localhost:5173 goes out to the
# invited master. It was unset on the pilot for the whole invite feature's
# life and nothing said so — `manage.py check` now warns (admin_api.W001).
#
# Pilot value: https://miniapp-dev.gobeauty.site
#
# This is the MINI APP origin, not the backend. `api-dev.gobeauty.site` is
# the Django host and answers 404 on /onboarding/master (and on its root):
# that route is a client-side route of the Mini App SPA. Setting the
# backend host here swaps one dead link for another, and this file said
# `api-dev` until 2026-08-25 — checked by live request, 404 vs 200.
SITE_DOMAIN=

# --- MAX channel ---
MAX_BOT_TOKEN=                # REQUIRED — MAX bot token (init-data verify + outbound).
MAX_BOT_TENANT_SLUG=          # REQUIRED — pilot tenant slug (Penza salon).

# --- Observability ---
SENTRY_DSN=                   # REQUIRED in staging — error reporting.

# --- LLM / AI ---
OPENAI_API_KEY=               # REQUIRED — concierge/FAQ intent + drafts.

# --- Optional (sprint-critical only if used) ---
# NUTRITION_SERVICE_TOKEN=    # nutrition X-Service-Token (food scanner, off-critical-path).
# CHROMA_HTTP_HOST=           # chromadb is NOT running in staging (sprint cut).
# CHROMA_AUTH_TOKEN=          # same — leave empty while chromadb is off.
