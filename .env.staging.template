# .env.staging TEMPLATE — copy to .env.staging and fill values OUT OF GIT.
# Names only here (secrets never committed). Loaded by every service via
# env_file in docker-compose.staging.yml. Values for the orchestrator.

# --- Django core ---
DJANGO_SECRET_KEY=            # REQUIRED — Django signing key (long random).
# DJANGO_ALLOWED_HOSTS — REQUIRED. Django rejects any request whose Host
# header is not on this list with 400 DisallowedHost. Until DRF-1391 the
# pilot ran with `*` (host checking off) because docker-compose.yml's
# `environment:` block overrode whatever this file said — see the header
# of docker-compose.yml. That override is gone; THIS file is now the only
# source, which means an incomplete list here takes the contour down.
#
# Every name below is load-bearing. Do not trim the list to "just the
# domain" — each entry is a caller that already exists:
#
#   api-dev.gobeauty.site  nginx (infra/nginx/ai-bot-platform-api.conf
#                          .template) proxies with `Host: $host`; the
#                          miniapp vhost forces the same value on /api/.
#                          Public traffic and admin login.
#   localhost              the `web` container's OWN healthcheck —
#                          docker-compose.staging.yml curls
#                          http://localhost:8000/healthz/. Drop this and
#                          the container reports unhealthy forever.
#   127.0.0.1              host-side readiness probe. .github/workflows/
#                          deploy-dev.yml curls http://127.0.0.1:8013/
#                          readyz/ with no Host override, so curl sends
#                          `Host: 127.0.0.1`. Drop this and every deploy
#                          goes red on a healthy contour.
#
# Pilot value (verbatim):
# DJANGO_ALLOWED_HOSTS=api-dev.gobeauty.site,localhost,127.0.0.1
DJANGO_ALLOWED_HOSTS=         # REQUIRED — see the three names above.

# --- Ayla internal API (booking/catalog/personal-context/billing) ---
AYLA_BASE_URL=                # REQUIRED — Ayla on this host: http://127.0.0.1:8000
AYLA_INTERNAL_API_TOKEN=      # REQUIRED — shared s2s Bearer with Ayla.
AYLA_CLIENT_PAYMENTS_RETURN_URL=  # C7 fallback return_url (miniapp public URL) until W4 FE sends it explicitly.

# --- Eventbus ingest (Ayla outbox → bot) ---
EVENT_INGEST_HMAC_SECRET=     # REQUIRED — == Ayla's AYLA_OUTBOUND_HMAC_SECRET.
# T-02 pilot ingest scope. BOTH are REQUIRED for any tenant-scoped event to be
# ingested — empty means DENY ALL, and staging no longer has a global fail-open
# to fall back on. Leaving these blank is SAFE but silently dead: every
# booking.* delivery from Ayla will 500 and dead-letter.
# No wildcards; a malformed value refuses to boot. Rollback = clear both.
# See docs/runbooks/eventbus-subscriber-activation.md §E.
EVENT_INGEST_ALLOWED_TENANTS= # REQUIRED for pilot ingest — CSV of tenant UUIDs.
EVENT_INGEST_ALLOWED_EVENTS=  # REQUIRED for pilot ingest — CSV of event names, e.g.
                              # booking.created,booking.cancelled,appointment.rescheduled
# EVENT_INGEST_TENANT_VERIFY_FAIL_OPEN=  # DO NOT SET. Emergency escape hatch that
                              # disables tenant verification for EVERY tenant and EVERY
                              # event. Widen the two allowlists above instead. See §E.

# --- Public addresses (DRF-1079) ---
# REQUIRED on any contour that is not the developer's laptop. Master invite
# DMs embed <SITE_DOMAIN>/onboarding/master?token=... as the web fallback;
# unset means the repository default http://localhost:5173 goes out to the
# invited master. It was unset on the pilot for the whole invite feature's
# life and nothing said so — `manage.py check` now warns (admin_api.W001).
#
# Pilot value: https://miniapp-dev.gobeauty.site
#
# This is the MINI APP origin, not the backend. `api-dev.gobeauty.site` is
# the Django host and answers 404 on /onboarding/master (and on its root):
# that route is a client-side route of the Mini App SPA. Setting the
# backend host here swaps one dead link for another, and this file said
# `api-dev` until 2026-08-25 — checked by live request, 404 vs 200.
SITE_DOMAIN=

# --- MAX channel ---
MAX_BOT_TOKEN=                # REQUIRED — MAX bot token (init-data verify + outbound).
MAX_BOT_TENANT_SLUG=          # REQUIRED — pilot tenant slug (Penza salon).

# --- Salon staff bot (DRF-1092) — NOT YET APPLIED ON THE PILOT ---
#
# Owner GO-gate. Written down here first because two of the traps below
# fail silently, and a silent failure found on a live pilot costs more
# than one found in a template.
#
# THE NAMES DRF-1092 WAS WRITTEN WITH ARE DEAD.
# `SALON_BOT_TOKEN` and `SALON_BOT_WEBHOOK_SECRET` are read by NOTHING.
# The ticket predates the bot registry (DRF-1061), whose docstring names
# «another lone SALON_BOT_TOKEN» as the approach it deliberately
# replaced. The pilot already carries a `SALON_BOT_TOKEN` (present since
# 15.08) and it has never been read by a single line of code. Adding
# `SALON_BOT_WEBHOOK_SECRET` beside it would change nothing at all, and
# nothing would say so.
#
# The registry reads these instead (config/settings/base.py:1434):
#
#   MAX_BOTS=client,salon
#   MAX_BOT_CLIENT_WEBHOOK_SECRET=  # = today's MAX_WEBHOOK_SECRET value
#   MAX_BOT_CLIENT_API_TOKEN=       # = today's MAX_BOT_TOKEN value
#   MAX_BOT_CLIENT_STREAM=max_global
#   MAX_BOT_SALON_WEBHOOK_SECRET=   # NEW — generate, give the same value to MAX
#   MAX_BOT_SALON_API_TOKEN=        # = the existing SALON_BOT_TOKEN value
#   MAX_BOT_SALON_TENANT_SLUG=      # the pilot salon's slug
#   MAX_BOT_SALON_STREAM=max_salon
#   MAX_BOT_SALON_WEB_APP=          # the salon bot's public MAX handle
#
# TRAP 1 — declaring one bot silently un-declares the other.
# `with_legacy_fallback` synthesizes the legacy entry ONLY when MAX_BOTS
# is empty (`if entries: return entries`). `MAX_BOTS=salon` alone drops
# the client bot from the registry: its webhooks stop resolving, every
# client message 401s at ingress, and the process boots perfectly. Both
# bots go in MAX_BOTS or neither does.
#
# TRAP 2 — the client bot's stream is not its default.
# The legacy fallback picks `max_global` when the webhook secret is
# listed in GLOBAL_BOT_TOKENS, which is the pilot's configuration. A
# declared bot has no such rule: unset STREAM means `max`, so the client
# bot would quietly move off the nationwide handler onto the tenant one.
# `MAX_BOT_CLIENT_STREAM=max_global` is not optional.
#
# TRAP 3 — do NOT set MAX_BOT_CLIENT_TENANT_SLUG.
# Setting it «for symmetry» moves the client bot from the tenant-less
# discovery path onto the tenant-bound one. base.py:1465 refuses to do
# this for the legacy entry precisely because it is a behaviour change,
# not a formality. Leave it absent; ingress keeps resolving tenancy from
# the channel-token map exactly as it does today.
#
# AFTER the values are in place, subscribe the salon bot EXPLICITLY:
#
#   python manage.py max_subscribe_webhook --bot salon \
#       --url https://api-dev.gobeauty.site/api/v1/ingress/max/ \
#       --update-type message_created \
#       --update-type message_callback \
#       --update-type bot_started
#
# `--bot salon` is load-bearing: without it the command uses
# MAX_BOT_TOKEN and subscribes the CLIENT bot while printing success
# (fixed 25.08, was the state on 15.08). The three `--update-type`
# flags are the 2026-05-21 incident: without `message_callback` MAX
# delivers no button taps and the bot looks broken but alive.
#
# The Mini App address for the salon bot is per-bot now — set
# MAX_BOT_SALON_MINIAPP_URL / MAX_BOT_SALON_WEB_APP rather than the
# global MAX_BOT_WEB_APP / MAX_MINIAPP_URL, so each bot renders its own
# open_app button. A declared entry reads ONLY its own prefix, so the
# global is not a fallback for it: leave MAX_BOT_SALON_WEB_APP unset and
# the salon bot has no Mini App no matter what the global says.
#
# TRAP 4 — MAX_BOT_SALON_WEB_APP is what makes the master invitation
# handable over at all (DRF-1504). Without it `_bot_start_link` returns
# `""`, the invite response carries no `invite_link`, and the only
# delivery left is a DM to a MAX username the salon already knows — no
# route at all for a master the system has never seen. The value is the
# bot's public handle (pilot: `id583403546770_3_bot`), the same string
# that appears in `https://max.ru/<handle>?start=...`. Procedure and
# post-restart checks: docs/runbooks/master-bot-onboarding.md,
# «Enabling the salon Mini App on the pilot».
#
# It was rolled back once, on 2026-08-30, because the staff menu's
# open_app payload then contained a colon and MAX 400s those — fixed in
# 0c3593a (#1337); the guard and the regression test now live in
# apps/channels/max/outbound.py and
# apps/channels/tests/test_salon_web_app_enablement.py.

