# Tenancy: tenant_id propagation, scope enforcement (ADR-0001/0003).
# Bug here cross-contaminates tenants → contractual breach.
apps/tenancy/                @AndreyDeveloper84
apps/tenancy/**              @AndreyDeveloper84

# Orchestrator safety: rate limits, circuit breakers, prompt
# injection defences. Bug here = uncontrolled LLM cost or unsafe
# behaviour reaching users.
apps/orchestrator/safety/    @AndreyDeveloper84
apps/orchestrator/safety/**  @AndreyDeveloper84

# Replay: PII redaction lives here. Mistake = leak of user data
# into fixtures / S3 / debugging artefacts.
