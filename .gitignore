MANIFEST

# Virtual environments
.venv/
venv/
env/
ENV/

# Django
db.sqlite3
db.sqlite3-journal
media/
staticfiles/
*.log
local_settings.py

# ChromaDB local persistence (KB-RAG K2 dev fallback when CHROMA_HTTP_HOST is unset).
# Per-developer / per-environment binary store; never committed.
.chroma/

# Environments
.env
.env.local
.env.*.local
!.env.example

# Claude Code MCP server config — must never be committed. Contains
# Figma / Notion / similar third-party API tokens (per issue #419).
# Operators copy `.mcp.json.example` → `.mcp.json` and source actual
# tokens from 1Password Connect (see docs/setup/secrets-vault.md).
.mcp.json
.mcp.local.json
!.mcp.json.example

# Testing / tooling
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover
.tox/

# IDEs
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# Build artefacts
*.pdf
!docs/**/*.pdf

# Local secrets (defence in depth)
secrets/
*.pem
*.key

# KB-RAG Sub-4 (GH #117) — Google Docs service-account JSON keys.
# The runbook puts the file at `infra/secrets/gdocs-sa.json`. The
# blanket `secrets/` rule above already covers this dir; we re-include
# the dir itself so a `.gitkeep` can be tracked (giving operators a
# stable mount point), then re-exclude every json inside it so a
# rotated key dropped into the folder can't accidentally be committed.
!infra/secrets/
infra/secrets/*.json
