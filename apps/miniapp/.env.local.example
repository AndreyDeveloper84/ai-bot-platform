# Dev-mode init-data bypass.
#
# Local browser dev only. Works ONLY when:
#   1. Django backend runs with DEBUG=True
#      (DJANGO_DEBUG=True uv run python manage.py runserver)
#   2. Vite runs in dev mode (npm run dev — production builds dead-code-
#      eliminate the bypass branch entirely)
#   3. Both vars below are set
#   4. No real MAX initData is present in window.WebApp (i.e. you're in
#      a plain Chrome tab, not inside the MAX wrapper)
#
# When all four hold, the Mini App injects three headers on every API
# request:
#   X-Dev-Bypass: 1
#   X-Dev-User-Id: <VITE_DEV_BYPASS_USER_ID>
#   X-Dev-Tenant-Slug: <VITE_DEV_BYPASS_TENANT_SLUG>
# The backend (apps/miniapp_api/dev_bypass.py) resolves the BotUser +
# Tenant from these headers, skipping HMAC verification.
#
# SECURITY:
#   - In production builds (npm run build) these headers are NOT injected
#     — the branch is dead-code-eliminated by Vite.
#   - In production backend (DEBUG=False) these headers are IGNORED —
#     the dev_bypass helper exits before reading any header.
#   - DO NOT commit .env.local. It is already in .gitignore.
#
# Bootstrap:
#   After running `python manage.py create_test_master_invite`, run
#   `python manage.py print_master_dev_env <master_id>` once the master
#   is linked (M0 onboarding complete) — it prints the snippet to paste
#   below.

VITE_DEV_BYPASS_USER_ID=
VITE_DEV_BYPASS_TENANT_SLUG=

# Ссылка на канал поддержки в MAX (#949, DRF-2654).
#
# Её открывает кнопка «Написать в поддержку» в шторках личных данных
# (выгрузка, удаление аккаунта, согласие на данные о здоровье, отзыв
# хранения данных) — чаще всего тогда, когда действие в приложении не
# получилось и оператор делает его вручную. Это путь человека к правам
# по 152-ФЗ, поэтому ссылка обязана вести в живой канал.
#
# В dev (`npm run dev`) можно оставить пустой: подставится заглушка
# `https://max.me/aylasupport`. Production-сборка (`npm run build`) без неё
# ОТКАЗЫВАЕТ с текстом `DRF-2654: production build needs
# VITE_SUPPORT_DEEPLINK` — чтобы заглушка не уехала людям под видом
# настройки. Для выкладки значение задаётся переменной репозитория, а не
# здесь: docs/runbooks/miniapp-build-env.md.
VITE_SUPPORT_DEEPLINK=

# Адрес входа MAX OAuth (DRF-1319).
#
# Выключателем регистрации служит САМ АДРЕС, а не булев флаг. Пусто —
# анонимный гость видит объяснение «регистрация скоро будет доступна» и
# может смотреть каталог дальше; непусто — кнопка «Зарегистрироваться»
# ведёт по этому адресу.
#
# Так сделано после DRF-1319: прежний `VITE_MAX_OAUTH_ENABLED` был
# упомянут в одном месте и не задан НИГДЕ, то есть ветка регистрации не
# исполнялась ни в одном окружении, но читалась как существующая. А
# включи его кто-нибудь — получил бы кнопку, возвращающую на главный
# экран. Условие на непустой адрес убирает оба состояния: включить
# регистрацию нельзя, не дав ей куда вести.
#
# На 10.09.2026 endpoint (W4) НЕ ВЫКАЧЕН — оставляйте пустым.
VITE_MAX_OAUTH_URL=
