# ai-bot-platform — Celery beat scheduler systemd unit (TEMPLATE).
#
# Placeholders: see ai-bot-platform-web.service.template.
# Install at: /etc/systemd/system/ai-bot-platform-{ENV}-beat.service
#
# CRITICAL: only ONE beat process per environment. If you run two,
# every periodic task fires twice. Use `systemctl is-active` to verify.

[Unit]
Description=ai-bot-platform Celery beat — {ENV}
After=network.target redis-server.service postgresql.service
Wants=network.target
Requires=redis-server.service

[Service]
Type=simple
User=taximeter
Group=taximeter
WorkingDirectory={DEPLOY_PATH}
EnvironmentFile={ENV_FILE}
Environment="DJANGO_SETTINGS_MODULE=config.settings.production"
Environment="PYTHONUNBUFFERED=1"
ExecStart={DEPLOY_PATH}/.venv/bin/celery -A config beat \
    --loglevel=INFO \
    --scheduler django_celery_beat.schedulers:DatabaseScheduler
Restart=on-failure
RestartSec=10

# Beat is single-threaded scheduling daemon — keep RAM tight.
MemoryMax=200M
MemoryHigh=150M

[Install]
WantedBy=multi-user.target
