# /etc/formula_tela/backup.env — example.
#
# Install on prod as:
#   sudo install -m 600 -o root -g root backup.env.example /etc/formula_tela/backup.env
#   sudo editor /etc/formula_tela/backup.env   # fill in real values
#
# All four scripts in scripts/backup/ source this file.
# Permissions MUST be 600 + root-owned — it contains S3 credentials.

# --- S3-compatible credentials ---
# Use a dedicated IAM user with only:
#   s3:GetObject, s3:PutObject, s3:ListBucket, s3:DeleteObject
# on the backup bucket. Do NOT use a console-login-capable user.
AWS_ACCESS_KEY_ID=REPLACE_ME
AWS_SECRET_ACCESS_KEY=REPLACE_ME

# Region — the awscli requires this even for non-AWS providers. Use the
# region closest to the prod VM (lower latency, lower egress cost).
AWS_DEFAULT_REGION=ru-central1

# Endpoint URL — set per provider:
#   AWS S3:                 https://s3.<region>.amazonaws.com
#   Yandex Object Storage:  https://storage.yandexcloud.net
#   MinIO (self-hosted):    http://minio.local:9000   (use https in prod)
S3_ENDPOINT_URL=https://storage.yandexcloud.net

# --- Bucket layout ---
S3_BUCKET=ai-bot-platform-prod-backups

# --- Postgres ---
# PG_DATA_DIR is mainly used by restore_pitr.sh as a prompt default.
PG_DATA_DIR=/var/lib/postgresql/14/main
PG_USER=postgres

# --- Retention ---
# 30 daily + 12 monthly per DRF-852 spec.
RETENTION_DAILY_DAYS=30
RETENTION_MONTHLY_MONTHS=12
